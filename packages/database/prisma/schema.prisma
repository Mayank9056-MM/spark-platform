generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

// DOMAIN 1 — IDENTITY (Users, RBAC, Sessions, Tokens)
// Single-college architecture: the deployment/database itself represents
// the college. There is no tenant boundary and no Organization/College
// table. Position/PositionAssignment intentionally removed for MVP
// (unchanged from before).

enum UserStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  LOCKED
  DEACTIVATED
  ARCHIVED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String?
  firstName    String
  middleName   String?
  lastName     String
  status       UserStatus @default(PENDING_ACTIVATION)
  avatarUrl    String?

  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  deletedAt            DateTime?
  lastPasswordChangeAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // onDelete intentionally left default (Restrict) on every back-relation
  // below that touches institutional history. Users are never hard-deleted;
  // use status = ARCHIVED / deletedAt instead.
  roleAssignments    RoleAssignment[]    @relation("UserRoleAssignments")
  grantedAssignments RoleAssignment[]    @relation("GrantedRoleAssignments")
  sessions           Session[]
  verificationTokens VerificationToken[]

  admission             Admission?              @relation("AdmittedStudent")
  admissionsProcessed   Admission[]             @relation("AdmittedBy")
  studentEnrollments    StudentEnrollment[]
  promotionBatches      PromotionBatch[]
  promotionDecisions    PromotionDecision[]
  facultyAssignments    FacultyAssignment[]
  attendanceSessions    AttendanceSession[]
  attendanceRecords     AttendanceRecord[]
  attendanceCorrections AttendanceRecord[]      @relation("AttendanceCorrectedBy")
  documentsUploaded     Document[]
  studyMaterials        StudyMaterial[]
  assignmentsCreated    Assignment[]
  submissionsGraded     AssignmentSubmission[]
  noticesCreated        Notice[]
  calendarEventsCreated CalendarEvent[]
  auditLogEntries       AuditLog[]
  notificationInbox     NotificationRecipient[]
  lecturesAsFaculty     Lecture[]               @relation("LectureFaculty")

  @@index([status])
  @@index([lastLoginAt])
  @@map("users")
}

model Role {
  id              String  @id @default(uuid())
  key             String  @unique
  displayName     String
  isSystemDefined Boolean @default(false)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  rolePermissions RolePermission[]
  roleAssignments RoleAssignment[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  key         String @unique
  displayName String
  description String

  createdAt DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  createdAt DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// Division removed from this refactor: only COLLEGE and DEPARTMENT remain
// as authorization scopes. Year/Semester are academic/enrollment concepts,
// not RBAC scope, and are deliberately not represented here.
enum ScopeType {
  COLLEGE
  DEPARTMENT
}

model RoleAssignment {
  id        String    @id @default(uuid())
  userId    String
  roleId    String
  scopeType ScopeType
  scopeId   String?

  validFrom  DateTime  @default(now())
  validUntil DateTime?

  grantedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Restrict (not Cascade): deleting a User must never silently delete
  // their role-assignment history. Archive the user instead.
  user      User  @relation("UserRoleAssignments", fields: [userId], references: [id])
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy User? @relation("GrantedRoleAssignments", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@index([roleId, scopeType, scopeId])
  @@index([userId, validUntil])
  @@map("role_assignments")
}

model Session {
  id         String  @id @default(uuid())
  userId     String
  userAgent  String?
  ipAddress  String?
  location   String?
  deviceName String?

  lastActivityAt DateTime  @default(now())
  revokedAt      DateTime?

  createdAt DateTime @default(now())
  expiresAt DateTime

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([userId, expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id        String @id @default(uuid())
  sessionId String
  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, revokedAt])
  @@map("refresh_tokens")
}

enum VerificationPurpose {
  ACCOUNT_ACTIVATION
  INVITE_USER
  PASSWORD_RESET
  EMAIL_CHANGE
}

model VerificationToken {
  id        String              @id @default(uuid())
  userId    String
  purpose   VerificationPurpose
  tokenHash String              @unique
  expiresAt DateTime
  usedAt    DateTime?
  metadata  Json? // controlled exception to normalization — e.g. holds the
  // pending new email for EMAIL_CHANGE until the token is consumed

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

// DOMAIN 2 — ACADEMIC STRUCTURE
// College > Department > Program > CurriculumVersion > SemesterCatalog.
// No Division layer: one cohort per program per academic year.

model Department {
  id   String @id @default(uuid())
  name String
  code String

  programs Program[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code])
  @@map("departments")
}

model Program {
  id             String @id @default(uuid())
  departmentId   String
  name           String
  code           String
  durationYears  Int
  totalSemesters Int

  department         Department          @relation(fields: [departmentId], references: [id])
  curriculumVersions CurriculumVersion[]
  studentEnrollments StudentEnrollment[]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  admissions Admission[]

  @@unique([code])
  @@index([departmentId])
  @@map("programs")
}

enum CurriculumStatus {
  DRAFT
  ACTIVE
  RETIRED
}

model CurriculumVersion {
  id        String           @id @default(uuid())
  programId String
  label     String
  status    CurriculumStatus @default(DRAFT)

  program Program @relation(fields: [programId], references: [id])

  semesterCatalogs   SemesterCatalog[]
  studentEnrollments StudentEnrollment[]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  admissions Admission[]

  @@unique([programId, label])
  @@index([programId, status])
  @@map("curriculum_versions")
}

// Semester number is scoped inside a curriculum version (e.g. Semester 3 of
// "CSE 2024"). Year is deliberately not persisted anywhere — it is derived
// from `number` against the owning Program's totalSemesters/durationYears
// (e.g. ceil(number / 2) for an 8-semester, 4-year program) rather than
// stored as a second source of truth.
model SemesterCatalog {
  id                  String @id @default(uuid())
  curriculumVersionId String
  number              Int

  curriculumVersion CurriculumVersion @relation(fields: [curriculumVersionId], references: [id])

  semesterEnrollments SemesterEnrollment[]
  subjects            Subject[]
  electiveGroups      ElectiveGroup[]
  promotionBatches    PromotionBatch[]
  timetableEntries    Timetable[]
  lectures            Lecture[]
  entryAdmissions     Admission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([curriculumVersionId, number])
  @@map("semester_catalogs")
}

model AcademicYear {
  id        String   @id @default(uuid())
  label     String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)

  semesterEnrollments SemesterEnrollment[]
  promotionBatches    PromotionBatch[]
  subjectOfferings    SubjectOffering[]
  timetableEntries    Timetable[]
  lectures            Lecture[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([label])
  @@index([isActive])
  @@map("academic_years")
}

// DOMAIN 3 — STUDENT LIFECYCLE (Admission → Enrollment → Promotion)

// Entry path only. Deliberately does not encode funding/reservation
// category (see Admission.quota) or entry semester (see
// Admission.entrySemesterCatalogId) — those are independent dimensions.
enum AdmissionType {
  NORMAL
  LATERAL
  EXCEPTION
}

enum AdmissionStatus {
  CONFIRMED
  CANCELLED
}

enum AdmissionQuota {
  GOVERNMENT_QUOTA
  MANAGEMENT_QUOTA
}

// Admission happens ONCE and is never StudentEnrollment — it is the
// historical record of how a student entered the institution, kept
// permanently distinct from their ongoing academic lifecycle.
model Admission {
  id                     String          @id @default(uuid())
  userId                 String          @unique
  admissionNumber        String
  admissionDate          DateTime
  admissionType          AdmissionType
  entrySemesterCatalogId String
  quota                  AdmissionQuota
  status                 AdmissionStatus @default(CONFIRMED)
  admittedByUserId       String
  initialProgramId       String
  initialCurriculumId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentEnrollment    StudentEnrollment?
  user                 User               @relation("AdmittedStudent", fields: [userId], references: [id])
  admittedBy           User               @relation("AdmittedBy", fields: [admittedByUserId], references: [id])
  initialProgram       Program            @relation(fields: [initialProgramId], references: [id])
  initialCurriculum    CurriculumVersion  @relation(fields: [initialCurriculumId], references: [id])
  entrySemesterCatalog SemesterCatalog    @relation(fields: [entrySemesterCatalogId], references: [id])
  // entrySemesterCatalog is independent of admissionType — e.g. LATERAL
  // does not imply Semester 3, EXCEPTION does not imply Semester 5.
  // Business rules for which (admissionType, entrySemesterCatalog)
  // combinations are valid belong to the future Admissions domain, not
  // this schema.
  // NOTE: does not enforce entrySemesterCatalog/initialCurriculum belong to
  // initialProgram — same class of multi-hop agreement check as Division
  // and CurriculumVersion elsewhere in this file; service-layer at
  // admission time, unchanged in spirit by this refactor.

  @@unique([admissionNumber])
  @@map("admissions")
}

enum StudentLifecycleStatus {
  ACTIVE
  ON_GAP_YEAR
  WITHDRAWN
  DISCONTINUED
  GRADUATED
  ALUMNI
}

model StudentEnrollment {
  id                  String    @id @default(uuid())
  userId              String
  programId           String
  curriculumVersionId String // locked at admission time; a later curriculum
  // revision does NOT retroactively change this student's syllabus
  admissionId         String    @unique
  admission           Admission @relation(fields: [admissionId], references: [id])

  rollNumber      String
  admissionDate   DateTime
  status          StudentLifecycleStatus @default(ACTIVE)
  statusReason    String?
  statusChangedAt DateTime?

  user                User                 @relation(fields: [userId], references: [id])
  program             Program              @relation(fields: [programId], references: [id])
  curriculumVersion   CurriculumVersion    @relation(fields: [curriculumVersionId], references: [id])
  semesterEnrollments SemesterEnrollment[]
  promotionDecisions  PromotionDecision[]
  // Note: elective selections relate to SemesterEnrollment, not directly
  // here — see StudentElectiveSelection's comment.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rollNumber])
  @@index([userId])
  @@index([programId, status])
  @@map("student_enrollments")
}

enum SemesterEnrollmentStatus {
  IN_PROGRESS
  PROMOTED
  REPEATED
  DETAINED
  WITHDRAWN
  DISCONTINUED
  GRADUATED
}

model SemesterEnrollment {
  id                  String                   @id @default(uuid())
  studentEnrollmentId String
  semesterCatalogId   String // WHICH curriculum semester (e.g. Semester 3 of IT-2024)
  academicYearId      String // WHICH real term this attempt happened in
  attemptNumber       Int                      @default(1) // 2nd time = a repeat
  status              SemesterEnrollmentStatus @default(IN_PROGRESS)

  studentEnrollment StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)
  semesterCatalog   SemesterCatalog   @relation(fields: [semesterCatalogId], references: [id])
  academicYear      AcademicYear      @relation(fields: [academicYearId], references: [id])

  openedByDecision      PromotionDecision?         @relation("DecisionOpensEnrollment")
  attendanceRecords     AttendanceRecord[]
  assignmentSubmissions AssignmentSubmission[]
  electiveSelections    StudentElectiveSelection[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  promotionDecisions PromotionDecision[] @relation("DecisionClosesEnrollment")

  @@unique([studentEnrollmentId, semesterCatalogId, attemptNumber])
  @@index([academicYearId, status])
  @@map("semester_enrollments")
}

enum PromotionBatchStatus {
  DRAFT
  FINALIZED
}

model PromotionBatch {
  id                String               @id @default(uuid())
  semesterCatalogId String // the FROM curriculum semester being promoted —
  // also identifies the program via semesterCatalog -> curriculumVersion ->
  // program, so programId is not separately stored here (avoids a second
  // source of truth for the same fact). Replaces the old divisionId scope;
  // this plus academicYearId is exactly how SemesterEnrollment's population
  // is already queried, so no new scoping concept was introduced.
  academicYearId    String
  initiatedByUserId String
  status            PromotionBatchStatus @default(DRAFT)
  finalizedAt       DateTime?

  semesterCatalog SemesterCatalog     @relation(fields: [semesterCatalogId], references: [id])
  academicYear    AcademicYear        @relation(fields: [academicYearId], references: [id])
  initiatedBy     User                @relation(fields: [initiatedByUserId], references: [id])
  decisions       PromotionDecision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // status = FINALIZED must make `decisions` immutable — enforced in the
  // promotion service (check status before any decision mutation), not the
  // DB. Unchanged by this refactor.

  @@index([semesterCatalogId, academicYearId, status])
  @@map("promotion_batches")
}

enum PromotionOutcome {
  PROMOTE
  REPEAT
  WITHDRAW
  DISCONTINUE
  GRADUATE
}

model PromotionDecision {
  id                       String           @id @default(uuid())
  promotionBatchId         String
  studentEnrollmentId      String
  fromSemesterEnrollmentId String           @unique
  toSemesterEnrollmentId   String?          @unique
  outcome                  PromotionOutcome
  remarks                  String?
  decidedByUserId          String
  decidedAt                DateTime         @default(now())

  createdAt DateTime @default(now())
  // Deliberately no updatedAt — a promotion decision is an immutable audit
  // record once made. DB-level backstop: REVOKE UPDATE on this table for
  // the app's runtime role (see migration.sql), same pattern as audit_logs.

  promotionBatch         PromotionBatch      @relation(fields: [promotionBatchId], references: [id], onDelete: Cascade)
  studentEnrollment      StudentEnrollment   @relation(fields: [studentEnrollmentId], references: [id])
  fromSemesterEnrollment SemesterEnrollment  @relation("DecisionClosesEnrollment", fields: [fromSemesterEnrollmentId], references: [id])
  toSemesterEnrollment   SemesterEnrollment? @relation("DecisionOpensEnrollment", fields: [toSemesterEnrollmentId], references: [id])
  decidedBy              User                @relation(fields: [decidedByUserId], references: [id])
  // NOTE: does not enforce fromSemesterEnrollment/toSemesterEnrollment
  // belong to the same studentEnrollmentId as this decision — three-way
  // agreement across independent FKs, not expressible without a trigger.
  // Enforce in the promotion service before insert. Unchanged by this
  // refactor.

  @@unique([promotionBatchId, studentEnrollmentId])
  @@index([studentEnrollmentId])
  @@map("promotion_decisions")
}

// DOMAIN 4 — CURRICULUM (Subjects, Components, Electives)

enum SubjectComponentType {
  THEORY
  PRACTICAL
  TUTORIAL
  PROJECT
}

model Subject {
  id                String  @id @default(uuid())
  semesterCatalogId String
  electiveGroupId   String? // null for core subjects
  code              String
  name              String
  isElective        Boolean @default(false)

  semesterCatalog    SemesterCatalog            @relation(fields: [semesterCatalogId], references: [id])
  electiveGroup      ElectiveGroup?             @relation(fields: [electiveGroupId], references: [id])
  components         SubjectComponent[]
  offerings          SubjectOffering[]
  electiveSelections StudentElectiveSelection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([semesterCatalogId, code])
  @@map("subjects")
}

// Groups mutually-exclusive open/departmental electives together within one
// semester catalog (e.g. "Open Elective Group 1": choose one of Python/AI/Cloud).
model ElectiveGroup {
  id                String @id @default(uuid())
  semesterCatalogId String
  name              String
  minSelect         Int    @default(1)
  maxSelect         Int    @default(1)

  semesterCatalog SemesterCatalog            @relation(fields: [semesterCatalogId], references: [id])
  subjects        Subject[]
  selections      StudentElectiveSelection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([semesterCatalogId, name])
  @@map("elective_groups")
}

// KNOWN SIMPLIFICATION (kept, unchanged by this refactor): the unique
// constraint below assumes exactly one selection per group per enrollment —
// correct for the common maxSelect=1 case. If a group ever allows choosing
// 2+ electives, drop the uniqueness and cap via an app-layer count check
// against ElectiveGroup.maxSelect instead.
model StudentElectiveSelection {
  id                   String @id @default(uuid())
  semesterEnrollmentId String
  electiveGroupId      String
  subjectId            String

  semesterEnrollment SemesterEnrollment @relation(fields: [semesterEnrollmentId], references: [id], onDelete: Cascade)
  electiveGroup      ElectiveGroup      @relation(fields: [electiveGroupId], references: [id])
  subject            Subject            @relation(fields: [subjectId], references: [id])

  createdAt DateTime @default(now())

  @@unique([semesterEnrollmentId, electiveGroupId])
  @@map("student_elective_selections")
}

model SubjectComponent {
  id           String               @id @default(uuid())
  subjectId    String
  type         SubjectComponentType
  credits      Int
  hoursPerWeek Int

  subject            Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  facultyAssignments FacultyAssignment[]
  timetableEntries   Timetable[]
  lectures           Lecture[]

  @@unique([subjectId, type])
  @@map("subject_components")
}

// The OFFERING concept — "Data Structures taught in 2025-26." One row per
// subject+academic-year regardless of how many components/faculty. No
// divisionId: there is exactly one cohort per program/semester/year, so
// subjectId + academicYearId is already a sufficient offering identity.
model SubjectOffering {
  id             String @id @default(uuid())
  subjectId      String
  academicYearId String

  subject      Subject      @relation(fields: [subjectId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  facultyAssignments FacultyAssignment[]
  timetableEntries   Timetable[]
  lectures           Lecture[]
  assignments        Assignment[]
  studyMaterials     StudyMaterial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subjectId, academicYearId])
  @@index([academicYearId])
  @@map("subject_offerings")
}

// DOMAIN 5 — TEACHING (Faculty Assignment, Rooms, Timetable)

// MVP simplification: one faculty per (offering, component) — no batch
// dimension, so no reason for this to be a list.
model FacultyAssignment {
  id                 String @id @default(uuid())
  subjectOfferingId  String
  subjectComponentId String
  facultyUserId      String

  subjectOffering  SubjectOffering  @relation(fields: [subjectOfferingId], references: [id], onDelete: Cascade)
  subjectComponent SubjectComponent @relation(fields: [subjectComponentId], references: [id])
  faculty          User             @relation(fields: [facultyUserId], references: [id])
  // NOTE: does not verify facultyUserId holds a faculty-capable role —
  // that's an RBAC concern, not a plain FK (role membership is itself a
  // table, not a boolean flag on User). Enforce via the RBAC service at
  // assignment time. NOTE: does not verify subjectComponentId belongs to
  // subjectOffering's Subject — 2-hop check, service-layer. Both unchanged
  // by this refactor.

  timetableEntries Timetable[]
  lectures         Lecture[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subjectOfferingId, subjectComponentId])
  @@index([facultyUserId])
  @@map("faculty_assignments")
}

enum RoomType {
  LECTURE_HALL
  LABORATORY
  SEMINAR_HALL
}

model Room {
  id       String   @id @default(uuid())
  name     String
  type     RoomType
  capacity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timetableEntries Timetable[]
  lectures         Lecture[]

  @@unique([name])
  @@map("rooms")
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model TimeSlot {
  id        String    @id @default(uuid())
  dayOfWeek DayOfWeek
  startTime DateTime  @db.Time
  endTime   DateTime  @db.Time

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timetableEntries Timetable[]

  @@index([dayOfWeek])
  @@map("time_slots")
}

// The RECURRING pattern — "this slot happens every Tuesday 10-11am in Room
// 204, for as long as effectiveTo is null."
model Timetable {
  id                String    @id @default(uuid())
  semesterCatalogId String // denormalized from subjectOffering.subject.semesterCatalogId
  academicYearId    String // denormalized from subjectOffering.academicYearId
  // Both required for the "this cohort cannot have two simultaneous
  // lectures" EXCLUDE constraint (migration.sql): an exclusion constraint
  // needs the conflicting value directly on the row, it cannot join through
  // subjectOffering/subject at constraint-check time. Together these two
  // fields are the population identity that divisionId used to carry —
  // there is now exactly one cohort per program/semester/year, so no
  // Division-equivalent concept is needed, just the two FKs that already
  // define that cohort elsewhere in this schema (see SemesterEnrollment).
  dayOfWeek         DayOfWeek // denormalized copy of timeSlot.dayOfWeek
  startTime         DateTime  @db.Time // denormalized copy of timeSlot.startTime
  endTime           DateTime  @db.Time // denormalized copy of timeSlot.endTime
  // These three are copied from TimeSlot at write time for the same
  // EXCLUDE-constraint reason as above. Safe because a Timetable row is
  // closed (effectiveTo set) and a new one created on any change, never
  // edited in place.

  subjectOfferingId   String
  subjectComponentId  String
  facultyAssignmentId String
  timeSlotId          String
  roomId              String
  effectiveFrom       DateTime  @default(now())
  effectiveTo         DateTime? // set when faculty/room/slot changes mid-term;
  // row is closed, never edited in place
  isCancelled         Boolean   @default(false)

  subjectOffering   SubjectOffering   @relation(fields: [subjectOfferingId], references: [id])
  semesterCatalog   SemesterCatalog   @relation(fields: [semesterCatalogId], references: [id])
  academicYear      AcademicYear      @relation(fields: [academicYearId], references: [id])
  subjectComponent  SubjectComponent  @relation(fields: [subjectComponentId], references: [id])
  facultyAssignment FacultyAssignment @relation(fields: [facultyAssignmentId], references: [id])
  timeSlot          TimeSlot          @relation(fields: [timeSlotId], references: [id])
  room              Room              @relation(fields: [roomId], references: [id])
  // Room/Faculty/cohort scheduling-conflict prevention is NOT expressible
  // as a Prisma relation or @@unique — see migration.sql for the
  // btree_gist EXCLUDE constraints that do the actual conflict rejection.
  // Those constraints previously keyed on divisionId; they need to be
  // rewritten to key on (semesterCatalogId, academicYearId) instead. NOT
  // done here — migration.sql was not provided.

  lectures Lecture[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([timeSlotId, roomId])
  @@index([subjectOfferingId])
  @@index([semesterCatalogId, academicYearId])
  @@map("timetables")
}

enum LectureStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

// The ACTUAL dated occurrence — where attendance attaches. Usually generated
// from a Timetable row; timetableId is nullable so an ad-hoc extra class
// doesn't need a fake recurring pattern behind it.
model Lecture {
  id                String @id @default(uuid())
  semesterCatalogId String // see Timetable.semesterCatalogId comment; same reasoning.
  academicYearId    String // see Timetable.academicYearId comment; same reasoning.
  facultyUserId     String // denormalized from facultyAssignment.facultyUserId.
  // The EXCLUDE constraint for "faculty can't teach two overlapping
  // lectures" needs the actual person, not the (offering, component)
  // assignment row — the same faculty member could hold two different
  // FacultyAssignment rows (different subjects) and still double-book
  // themselves.

  timetableId         String?
  subjectOfferingId   String
  subjectComponentId  String
  facultyAssignmentId String
  roomId              String
  scheduledDate       DateTime      @db.Date
  startTime           DateTime      @db.Time
  endTime             DateTime      @db.Time
  status              LectureStatus @default(SCHEDULED)

  semesterCatalog   SemesterCatalog    @relation(fields: [semesterCatalogId], references: [id])
  academicYear      AcademicYear       @relation(fields: [academicYearId], references: [id])
  facultyUser       User               @relation("LectureFaculty", fields: [facultyUserId], references: [id])
  timetable         Timetable?         @relation(fields: [timetableId], references: [id])
  subjectOffering   SubjectOffering    @relation(fields: [subjectOfferingId], references: [id])
  subjectComponent  SubjectComponent   @relation(fields: [subjectComponentId], references: [id])
  facultyAssignment FacultyAssignment  @relation(fields: [facultyAssignmentId], references: [id])
  room              Room               @relation(fields: [roomId], references: [id])
  attendanceSession AttendanceSession?
  // As with Timetable: Room/Faculty/cohort double-booking prevention is a
  // Postgres EXCLUDE constraint in migration.sql (must be rewritten to key
  // on semesterCatalogId + academicYearId instead of divisionId, same as
  // Timetable — not done here, file not provided). subjectComponent
  // belonging to subjectOffering.subject, and facultyAssignment belonging
  // to the same offering/component, remain service-layer (multi-hop
  // agreement checks) — unchanged by this refactor.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subjectOfferingId, scheduledDate, startTime])
  @@index([facultyAssignmentId, scheduledDate])
  @@index([semesterCatalogId, scheduledDate])
  @@map("lectures")
}

// DOMAIN 6 — ATTENDANCE

enum AttendanceSessionStatus {
  OPEN
  LOCKED
}

// 1:1 with Lecture, deliberately — no batch dimension. The Lecture already
// carries the cohort identity; this row just anchors AttendanceRecord rows.
model AttendanceSession {
  id            String                  @id @default(uuid())
  lectureId     String                  @unique
  takenByUserId String
  status        AttendanceSessionStatus @default(OPEN)
  lockedAt      DateTime?

  lecture Lecture            @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  takenBy User               @relation(fields: [takenByUserId], references: [id])
  records AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("attendance_sessions")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model AttendanceRecord {
  id                   String           @id @default(uuid())
  attendanceSessionId  String
  semesterEnrollmentId String // ties to the student's CURRENT term context,
  // not the bare User — consistent with the catalog/offering split elsewhere
  status               AttendanceStatus
  markedByUserId       String
  correctedAt          DateTime?
  correctionReason     String?
  correctedByUserId    String? // a correction changes an academic record
  // after the fact; who made it must be independently attributable from
  // who marked it originally (markedByUserId), for audit purposes. Nullable
  // because most records are never corrected.

  attendanceSession  AttendanceSession  @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  semesterEnrollment SemesterEnrollment @relation(fields: [semesterEnrollmentId], references: [id])
  markedBy           User               @relation(fields: [markedByUserId], references: [id])
  correctedBy        User?              @relation("AttendanceCorrectedBy", fields: [correctedByUserId], references: [id])
  // Eligibility guard (SemesterEnrollment.semesterCatalog/academicYear must
  // match Lecture.subjectOffering's semesterCatalog/academicYear) is NOT
  // DB-expressible — two independent join paths, not a shared FK. Enforced
  // in the attendance service at record-creation time, unchanged by this
  // refactor. A DB CHECK that correctedAt and correctionReason are both set
  // or both null remains in migration.sql, untouched by this refactor.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attendanceSessionId, semesterEnrollmentId])
  @@index([semesterEnrollmentId, status])
  @@map("attendance_records")
}

// DOMAIN 7 — ASSIGNMENTS & STUDY MATERIAL
// Attachments deliberately do NOT get their own tables (no
// AssignmentAttachment / StudyMaterialAttachment) — see Document below.
// Unaffected by this refactor — never had a Division dependency.

model Assignment {
  id                String   @id @default(uuid())
  subjectOfferingId String
  title             String
  description       String
  dueAt             DateTime
  maxMarks          Int?
  createdByUserId   String

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  subjectOffering SubjectOffering        @relation(fields: [subjectOfferingId], references: [id])
  createdBy       User                   @relation(fields: [createdByUserId], references: [id])
  submissions     AssignmentSubmission[]

  @@index([subjectOfferingId])
  @@map("assignments")
}

enum SubmissionStatus {
  SUBMITTED
  LATE
  GRADED
  RESUBMISSION_REQUESTED
}

model AssignmentSubmission {
  id                   String           @id @default(uuid())
  assignmentId         String
  semesterEnrollmentId String // same "tie to term context, not bare User"
  // convention as AttendanceRecord
  status               SubmissionStatus @default(SUBMITTED)
  submittedAt          DateTime         @default(now())
  marksAwarded         Int?
  feedback             String?
  gradedByUserId       String?
  gradedAt             DateTime?

  assignment         Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  semesterEnrollment SemesterEnrollment @relation(fields: [semesterEnrollmentId], references: [id])
  gradedBy           User?              @relation(fields: [gradedByUserId], references: [id])
  // marksAwarded <= assignment.maxMarks: a CHECK constraint cannot
  // reference another table's column in Postgres. Enforced in the grading
  // service before UPDATE. Cross-cohort submission guard is the same class
  // of check as AttendanceRecord's eligibility guard — service-layer,
  // unchanged.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, semesterEnrollmentId])
  @@index([semesterEnrollmentId])
  @@map("assignment_submissions")
}

model StudyMaterial {
  id                String  @id @default(uuid())
  subjectOfferingId String
  title             String
  description       String?
  uploadedByUserId  String

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  subjectOffering SubjectOffering @relation(fields: [subjectOfferingId], references: [id])
  uploadedBy      User            @relation(fields: [uploadedByUserId], references: [id])

  @@index([subjectOfferingId])
  @@map("study_materials")
}

// DOMAIN 8 — COMMUNICATION (Notice, Notification, Calendar)

model Notice {
  id              String    @id @default(uuid())
  title           String
  body            String
  publishedAt     DateTime?
  createdByUserId String

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  createdBy User             @relation(fields: [createdByUserId], references: [id])
  audiences NoticeAudience[]

  @@index([publishedAt])
  @@map("notices")
}

// Separate table, not a single scope pair on Notice, because one notice may
// need to target MULTIPLE audiences at once — a single scopeType/scopeId
// pair can't express that fan-out.
model NoticeAudience {
  id       String    @id @default(uuid())
  noticeId String
  scope    ScopeType
  scopeId  String? // null when scope = COLLEGE — enforced via CHECK in
  // migration.sql. Polymorphic FK to Department when scope = DEPARTMENT —
  // service-layer, same reasoning as RoleAssignment.scopeId. (Previously
  // also polymorphic to Division; that branch no longer applies now that
  // Division/DIVISION scope has been removed.)

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@index([noticeId])
  @@index([scope, scopeId])
  @@map("notice_audiences")
}

enum NotificationType {
  NOTICE_PUBLISHED
  ASSIGNMENT_DUE
  ATTENDANCE_LOW
  GRADE_POSTED
  ROLE_GRANTED
  GENERIC
}

// Split from NotificationRecipient deliberately: a notice going to 500
// students shouldn't duplicate title/body 500 times — one Notification row,
// many per-user delivery/read-state rows.
model Notification {
  id       String           @id @default(uuid())
  type     NotificationType
  title    String
  body     String
  metadata Json? // polymorphic reference payload — e.g. { assignmentId }

  createdAt DateTime @default(now())

  recipients NotificationRecipient[]

  @@index([type])
  @@map("notifications")
}

model NotificationRecipient {
  id             String    @id @default(uuid())
  notificationId String
  userId         String
  deliveredAt    DateTime?
  readAt         DateTime?

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt])
  @@map("notification_recipients")
}

enum CalendarEventType {
  HOLIDAY
  EXAM
  WORKSHOP
  SEMINAR
  PLACEMENT
  TECH_FEST
  SPORTS
  MEETING
  OTHER
}

model CalendarEvent {
  id              String            @id @default(uuid())
  type            CalendarEventType
  title           String
  description     String?
  startAt         DateTime
  endAt           DateTime
  scopeType       ScopeType         @default(COLLEGE) // reuses the existing
  // RBAC/Notice scope enum rather than inventing a new one
  scopeId         String? // null when scopeType = COLLEGE — enforced via
  // CHECK in migration.sql, same as NoticeAudience/RoleAssignment.
  createdByUserId String

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  createdBy User @relation(fields: [createdByUserId], references: [id])

  @@index([startAt])
  @@index([scopeType, scopeId])
  @@map("calendar_events")
}

// DOMAIN 9 — SYSTEM (Documents, Audit, Settings)

enum DocumentOwnerType {
  ASSIGNMENT
  ASSIGNMENT_SUBMISSION
  STUDY_MATERIAL
  NOTICE
}

model Document {
  id               String            @id @default(uuid())
  ownerType        DocumentOwnerType
  ownerId          String
  fileName         String
  mimeType         String
  sizeBytes        Int
  storageKey       String // path/key in Cloudflare R2 / S3 — DB stores
  // metadata only, actual bytes live in object storage
  uploadedByUserId String

  deletedAt DateTime?
  createdAt DateTime  @default(now())

  uploadedBy User @relation(fields: [uploadedByUserId], references: [id])
  // ownerId is polymorphic (points at Assignment, AssignmentSubmission,
  // StudyMaterial, or Notice depending on ownerType) — no real FK is
  // possible without a generic ownership table, which is not worth the
  // complexity for four owner types. The document service MUST verify: the
  // owner row exists and ownerType is one of the four valid values, before
  // persisting. MIME-type validation and file-size sanity checks continue
  // to happen outside the DB, at upload time.

  @@index([ownerType, ownerId])
  @@map("documents")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ARCHIVE
  RESTORE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  LOGOUT_ALL_DEVICES
  SESSION_REVOKED
  ACCOUNT_ACTIVATED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  ROLE_GRANTED
  ROLE_REVOKED
  PERMISSION_CHANGED
  OTHER
}

model AuditLog {
  id          String      @id @default(uuid())
  actorUserId String?
  action      AuditAction
  entityType  String

  entityId  String
  oldValue  Json?
  newValue  Json?
  requestId String? // correlates an audit row back to the exact HTTP
  // request that produced it. Populated automatically from the
  // AsyncLocalStorage log context by auditService.record/recordTx; callers
  // only need to pass it explicitly if recording outside a request (a job).
  ipAddress String?
  userAgent String?
  // Deliberately no updatedAt: append-only. oldValue/newValue must NEVER
  // contain passwordHash, refresh/session token values, or verification
  // token hashes — the audit-writing service is responsible for redacting
  // these fields before serializing a diff. DB-level append-only
  // enforcement (REVOKE UPDATE/DELETE for the app's runtime role) requires
  // a separate migration/runtime-role from the migration/owner role — NOT
  // YET CONFIGURED in this deployment (single dev role), unchanged by this
  // refactor. Until that separation exists, append-only is enforced only by
  // the application never exposing an update/delete endpoint for this
  // table — a real gap, not a solved one; do not claim otherwise.

  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action, createdAt])
  @@index([actorUserId])
  @@map("audit_logs")
}

model SystemSetting {
  id    String @id @default(uuid())
  key   String @unique
  value Json // intentionally loose — supports any setting shape (string,
  // number, boolean, nested object) without a migration per new key.
  // Recommendation (application-level, not a schema change): back this
  // with a typed settings registry/validation layer in the service — a
  // known set of `key` -> expected-shape mappings, validated on write —
  // rather than normalizing every setting into its own relational column.
  // Core business data (everything above) stays relational; this stays
  // JSON deliberately.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
