generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

// DOMAIN 1 — IDENTITY (Tenancy, Users, RBAC, Sessions, Tokens)
// Position/PositionAssignment intentionally removed for MVP.

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Organization {
  id     String             @id @default(uuid())
  name   String
  slug   String             @unique
  status OrganizationStatus @default(ACTIVE)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users               User[]
  roles               Role[]
  departments         Department[]
  academicYears       AcademicYear[]
  studentEnrollments  StudentEnrollment[]
  promotionBatches    PromotionBatch[]
  notices             Notice[]
  notifications       Notification[]
  calendarEvents      CalendarEvent[]
  auditLogs           AuditLog[]
  settings            OrganizationSetting[]
  subjects            Subject[]
  rooms               Room[]
  timeSlots           TimeSlot[]
  documents           Document[]
  admissions          Admission[]
  subjectOfferings    SubjectOffering[]
  roleAssignments     RoleAssignment[]
  programs            Program[]
  divisions           Division[]
  curriculumVersions  CurriculumVersion[]
  semesterCatalogs    SemesterCatalog[]
  semesterEnrollments SemesterEnrollment[]
  timetables          Timetable[]
  lectures            Lecture[]
  facultyAssignments  FacultyAssignment[]

  @@unique([id]) // trivially satisfied (id is already PK) — present only so
  // every composite-FK "child" model below can consistently reference
  // Organization the same way it references every other tenant-scoped parent.
  @@index([status])
  @@map("organizations")
}

enum UserStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  LOCKED
  DEACTIVATED
  ARCHIVED
}

model User {
  id             String     @id @default(uuid())
  organizationId String
  email          String
  passwordHash   String?
  firstName      String
  middleName     String?
  lastName       String
  status         UserStatus @default(PENDING_ACTIVATION)
  avatarUrl      String?

  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  deletedAt            DateTime?
  lastPasswordChangeAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  // onDelete intentionally left default (Restrict) on every back-relation
  // below that touches institutional history — see ANALYSIS.md §H. Users are
  // never hard-deleted; use status = ARCHIVED / deletedAt instead.
  roleAssignments    RoleAssignment[]    @relation("UserRoleAssignments")
  grantedAssignments RoleAssignment[]    @relation("GrantedRoleAssignments")
  sessions           Session[]
  verificationTokens VerificationToken[]

  admission             Admission?              @relation("AdmittedStudent")
  admissionsProcessed   Admission[]             @relation("AdmittedBy")
  studentEnrollments    StudentEnrollment[]
  promotionBatches      PromotionBatch[]
  promotionDecisions    PromotionDecision[]
  facultyAssignments    FacultyAssignment[]
  attendanceSessions    AttendanceSession[]
  attendanceRecords     AttendanceRecord[]
  attendanceCorrections AttendanceRecord[]      @relation("AttendanceCorrectedBy")
  documentsUploaded     Document[]
  studyMaterials        StudyMaterial[]
  assignmentsCreated    Assignment[]
  submissionsGraded     AssignmentSubmission[]
  noticesCreated        Notice[]
  calendarEventsCreated CalendarEvent[]
  auditLogEntries       AuditLog[]
  notificationInbox     NotificationRecipient[]
  lecturesAsFaculty     Lecture[]               @relation("LectureFaculty")

  @@unique([organizationId, email])
  @@unique([organizationId, id]) // enables composite FKs from RoleAssignment
  // (and any future model) that must prove userId belongs to the same
  // organizationId it declares — see RoleAssignment below.
  @@index([organizationId, status])
  @@index([organizationId, lastLoginAt])
  @@map("users")
}

model Role {
  id              String  @id @default(uuid())
  organizationId  String
  key             String
  displayName     String
  isSystemDefined Boolean @default(false)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id])
  rolePermissions RolePermission[]
  roleAssignments RoleAssignment[]

  @@unique([organizationId, key])
  @@unique([organizationId, id]) // composite-FK target for RoleAssignment
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  key         String @unique
  displayName String
  description String

  createdAt DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  createdAt DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

enum ScopeType {
  ORGANIZATION
  DEPARTMENT
  DIVISION
}

model RoleAssignment {
  id             String    @id @default(uuid())
  userId         String
  organizationId String // denormalized from User.organizationId — enables
  // tenant-scoped queries/future partitioning without a join at scale
  roleId         String
  scopeType      ScopeType
  scopeId        String?
  // DB enforces: scopeType = ORGANIZATION -> scopeId IS NULL (CHECK, see
  // migration.sql). It CANNOT enforce "scopeId belongs to the right org" —
  // scopeId polymorphically points at Department OR Division depending on
  // scopeType, and Postgres has no native polymorphic FK. The RBAC service
  // MUST validate scopeId's tenant/existence before insert, in the same
  // transaction that writes the AuditLog entry (see ANALYSIS.md §G/§K).

  validFrom  DateTime  @default(now())
  validUntil DateTime?

  grantedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Changed from Cascade -> Restrict (see ANALYSIS.md §H): deleting a User
  // must never silently delete their role-assignment history. Archive the
  // user instead.
  user         User         @relation("UserRoleAssignments", fields: [organizationId, userId], references: [organizationId, id])
  role         Role         @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)
  // ^ Both are now composite FKs: Postgres physically rejects a RoleAssignment
  // whose organizationId doesn't match its User's or its Role's organizationId.
  // This is the concrete fix for the "User A + Role B across orgs" scenario
  // called out in the brief.
  grantedBy    User?        @relation("GrantedRoleAssignments", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([roleId, scopeType, scopeId])
  @@index([userId, validUntil])
  @@map("role_assignments")
}

model Session {
  id         String  @id @default(uuid())
  userId     String
  userAgent  String?
  ipAddress  String?
  location   String?
  deviceName String?

  lastActivityAt DateTime  @default(now())
  revokedAt      DateTime?

  createdAt DateTime @default(now())
  expiresAt DateTime

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([userId, expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id        String @id @default(uuid())
  sessionId String
  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, revokedAt])
  @@map("refresh_tokens")
}

enum VerificationPurpose {
  ACCOUNT_ACTIVATION
  INVITE_USER
  PASSWORD_RESET
  EMAIL_CHANGE
}

model VerificationToken {
  id        String              @id @default(uuid())
  userId    String
  purpose   VerificationPurpose
  tokenHash String              @unique
  expiresAt DateTime
  usedAt    DateTime?
  metadata  Json? // controlled exception to normalization — e.g. holds the
  // pending new email for EMAIL_CHANGE until the token is consumed

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

// DOMAIN 2 — ACADEMIC STRUCTURE

model Department {
  id             String @id @default(uuid())
  organizationId String
  name           String
  code           String

  organization Organization @relation(fields: [organizationId], references: [id])
  programs     Program[]
  divisions    Division[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@unique([organizationId, id]) // composite-FK target for Program, Division
  @@index([organizationId])
  @@map("departments")
}

model Program {
  id             String @id @default(uuid())
  organizationId String // denormalized from Department.organizationId — same
  // pattern/justification as RoleAssignment.organizationId
  departmentId   String
  name           String
  code           String
  durationYears  Int
  totalSemesters Int

  department         Department          @relation(fields: [organizationId, departmentId], references: [organizationId, id])
  // ^ composite FK: was single-column departmentId -> Department.id before;
  // now Postgres enforces Program.organizationId == Department.organizationId.
  organization       Organization        @relation(fields: [organizationId], references: [id])
  curriculumVersions CurriculumVersion[]
  divisions          Division[]
  studentEnrollments StudentEnrollment[]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  admissions Admission[]

  @@unique([organizationId, code])
  @@unique([organizationId, id]) // composite-FK target for Division, Admission,
  // StudentEnrollment, CurriculumVersion
  @@index([organizationId])
  @@index([departmentId])
  @@map("programs")
}

enum CurriculumStatus {
  DRAFT
  ACTIVE
  RETIRED
}

model CurriculumVersion {
  id             String           @id @default(uuid())
  organizationId String // denormalized from Program.organizationId — same
  // pattern/justification as Program.organizationId.
  programId      String
  label          String
  status         CurriculumStatus @default(DRAFT)

  organization Organization @relation(fields: [organizationId], references: [id])
  program      Program      @relation(fields: [organizationId, programId], references: [organizationId, id])

  semesterCatalogs   SemesterCatalog[]
  studentEnrollments StudentEnrollment[]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  admissions Admission[]

  @@unique([programId, label])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([programId, status])
  @@map("curriculum_versions")
}

model SemesterCatalog {
  id                  String @id @default(uuid())
  organizationId      String // denormalized from CurriculumVersion.organizationId
  curriculumVersionId String
  number              Int

  organization      Organization      @relation(fields: [organizationId], references: [id])
  curriculumVersion CurriculumVersion @relation(fields: [organizationId, curriculumVersionId], references: [organizationId, id])

  semesterEnrollments SemesterEnrollment[]
  subjects            Subject[]
  electiveGroups      ElectiveGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([curriculumVersionId, number])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("semester_catalogs")
}

model AcademicYear {
  id             String   @id @default(uuid())
  organizationId String
  label          String
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean  @default(false)
  // "At most one AcademicYear per organization may have isActive = true" is
  // enforced at the DATABASE level via a partial unique index — see
  // migration.sql (`academic_years_one_active_per_org`). Prisma's
  // declarative schema syntax cannot express a partial/conditional unique
  // index, so this constraint lives in a raw SQL migration, not here.

  organization        Organization         @relation(fields: [organizationId], references: [id])
  divisions           Division[]
  semesterEnrollments SemesterEnrollment[]
  promotionBatches    PromotionBatch[]
  subjectOfferings    SubjectOffering[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, label])
  @@unique([organizationId, id]) // composite-FK target for Division,
  // SemesterEnrollment, SubjectOffering
  @@index([organizationId, isActive])
  @@map("academic_years")
}

model Division {
  id             String @id @default(uuid())
  organizationId String
  programId      String
  academicYearId String
  departmentId   String
  name           String // "A", "B"

  program      Program      @relation(fields: [organizationId, programId], references: [organizationId, id])
  academicYear AcademicYear @relation(fields: [organizationId, academicYearId], references: [organizationId, id])
  department   Department   @relation(fields: [organizationId, departmentId], references: [organizationId, id])
  organization Organization @relation(fields: [organizationId], references: [id])
  // All three parent relations are now composite FKs — a Division can no
  // longer reference a Program/AcademicYear/Department belonging to a
  // different organization than the Division itself declares. Note this
  // does NOT yet guarantee Division.departmentId == Program.departmentId
  // (the institutional invariant called out in the brief) — Postgres can't
  // express "these two FKs must agree" without a trigger, and a trigger for
  // a single cross-field agreement check is more machinery than the rule is
  // worth. Enforce in the service layer when creating/updating a Division.

  semesterEnrollments SemesterEnrollment[]
  promotionBatches    PromotionBatch[]
  subjectOfferings    SubjectOffering[]
  timetableEntries    Timetable[]
  lectures            Lecture[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([programId, academicYearId, name])
  @@unique([organizationId, id]) // composite-FK target for SubjectOffering,
  // SemesterEnrollment, Timetable, Lecture
  @@index([organizationId])
  @@index([academicYearId])
  @@index([departmentId])
  @@map("divisions")
}

// DOMAIN 3 — STUDENT LIFECYCLE (Admission → Enrollment → Promotion)

enum AdmissionType {
  REGULAR
  LATERAL_ENTRY
  MANAGEMENT_QUOTA
  GOVERNMENT_QUOTA
}

enum AdmissionStatus {
  CONFIRMED
  CANCELLED
}

// Admission happens ONCE and is never StudentEnrollment — it is the
// historical record of how a student entered the institution, kept
// permanently distinct from their ongoing academic lifecycle.
model Admission {
  id                  String          @id @default(uuid())
  organizationId      String
  userId              String          @unique
  admissionNumber     String
  admissionDate       DateTime
  admissionType       AdmissionType
  quota               String?
  status              AdmissionStatus @default(CONFIRMED)
  admittedByUserId    String
  initialProgramId    String
  initialCurriculumId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User              @relation("AdmittedStudent", fields: [userId], references: [id])
  admittedBy        User              @relation("AdmittedBy", fields: [admittedByUserId], references: [id])
  initialProgram    Program           @relation(fields: [organizationId, initialProgramId], references: [organizationId, id])
  initialCurriculum CurriculumVersion @relation(fields: [organizationId, initialCurriculumId], references: [organizationId, id])
  organization      Organization      @relation(fields: [organizationId], references: [id])
  // NOTE: does not enforce initialCurriculum belongs to initialProgram
  // (only that both belong to the same org) — that cross-field agreement is
  // a service-layer check at admission time, same reasoning as Division above.

  @@unique([organizationId, admissionNumber])
  @@index([organizationId])
  @@map("admissions")
}

enum EnrollmentType {
  REGULAR
  LATERAL_ENTRY
  READMISSION
}

enum StudentLifecycleStatus {
  ACTIVE
  ON_GAP_YEAR
  WITHDRAWN
  DISCONTINUED
  GRADUATED
  ALUMNI
}

model StudentEnrollment {
  id                  String                 @id @default(uuid())
  organizationId      String
  userId              String
  programId           String
  curriculumVersionId String // locked at admission time; a later curriculum
  // revision does NOT retroactively change this student's syllabus
  enrollmentType      EnrollmentType
  rollNumber          String
  admissionDate       DateTime
  status              StudentLifecycleStatus @default(ACTIVE)
  statusReason        String?
  statusChangedAt     DateTime?

  organization        Organization         @relation(fields: [organizationId], references: [id])
  user                User                 @relation(fields: [userId], references: [id])
  program             Program              @relation(fields: [organizationId, programId], references: [organizationId, id])
  curriculumVersion   CurriculumVersion    @relation(fields: [organizationId, curriculumVersionId], references: [organizationId, id])
  semesterEnrollments SemesterEnrollment[]
  promotionDecisions  PromotionDecision[]
  // Note: elective selections relate to SemesterEnrollment, not directly
  // here — see StudentElectiveSelection's comment.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, rollNumber])
  @@unique([organizationId, id]) // composite-FK target for SemesterEnrollment
  @@index([userId])
  @@index([programId, status])
  @@map("student_enrollments")
}

enum SemesterEnrollmentStatus {
  IN_PROGRESS
  PROMOTED
  REPEATED
  DETAINED
  WITHDRAWN
  DISCONTINUED
  GRADUATED
}

model SemesterEnrollment {
  id                  String                   @id @default(uuid())
  organizationId      String // NEW — denormalized from StudentEnrollment.organizationId.
  // Needed to give AttendanceRecord/AssignmentSubmission/StudentElectiveSelection
  // a tenant-consistent anchor, and to let this model carry composite FKs to
  // SemesterCatalog/AcademicYear/Division instead of trusting the app.
  studentEnrollmentId String
  semesterCatalogId   String // WHICH curriculum semester (e.g. Semester 3 of IT-2024)
  academicYearId      String // WHICH real term this attempt happened in
  divisionId          String
  attemptNumber       Int                      @default(1) // 2nd time = a repeat
  status              SemesterEnrollmentStatus @default(IN_PROGRESS)

  organization      Organization      @relation(fields: [organizationId], references: [id])
  studentEnrollment StudentEnrollment @relation(fields: [organizationId, studentEnrollmentId], references: [organizationId, id], onDelete: Cascade)
  semesterCatalog   SemesterCatalog   @relation(fields: [organizationId, semesterCatalogId], references: [organizationId, id])
  academicYear      AcademicYear      @relation(fields: [organizationId, academicYearId], references: [organizationId, id])
  division          Division          @relation(fields: [organizationId, divisionId], references: [organizationId, id])

  openedByDecision      PromotionDecision?         @relation("DecisionOpensEnrollment")
  attendanceRecords     AttendanceRecord[]
  assignmentSubmissions AssignmentSubmission[]
  electiveSelections    StudentElectiveSelection[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  promotionDecisions PromotionDecision[] @relation("DecisionClosesEnrollment")

  @@unique([studentEnrollmentId, semesterCatalogId, attemptNumber])
  @@unique([organizationId, id]) // composite-FK target for AttendanceRecord,
  // AssignmentSubmission, StudentElectiveSelection
  @@index([organizationId])
  @@index([divisionId, status])
  @@index([academicYearId, status])
  @@map("semester_enrollments")
}

enum PromotionBatchStatus {
  DRAFT
  FINALIZED
}

model PromotionBatch {
  id                String               @id @default(uuid())
  organizationId    String
  divisionId        String
  academicYearId    String
  initiatedByUserId String
  status            PromotionBatchStatus @default(DRAFT)
  finalizedAt       DateTime?

  organization Organization        @relation(fields: [organizationId], references: [id])
  division     Division            @relation(fields: [organizationId, divisionId], references: [organizationId, id])
  academicYear AcademicYear        @relation(fields: [organizationId, academicYearId], references: [organizationId, id])
  initiatedBy  User                @relation(fields: [initiatedByUserId], references: [id])
  decisions    PromotionDecision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // status = FINALIZED must make `decisions` immutable — enforced in the
  // promotion service (check status before any decision mutation), not the
  // DB. See ANALYSIS.md §L for why a trigger isn't worth it here.

  @@index([divisionId, status])
  @@map("promotion_batches")
}

enum PromotionOutcome {
  PROMOTE
  REPEAT
  WITHDRAW
  DISCONTINUE
  GRADUATE
}

model PromotionDecision {
  id                       String           @id @default(uuid())
  promotionBatchId         String
  studentEnrollmentId      String
  fromSemesterEnrollmentId String           @unique
  toSemesterEnrollmentId   String?          @unique
  outcome                  PromotionOutcome
  remarks                  String?
  decidedByUserId          String
  decidedAt                DateTime         @default(now())

  createdAt DateTime @default(now())
  // Deliberately no updatedAt — a promotion decision is an immutable audit
  // record once made; it should never be edited after the fact. DB-level
  // backstop: REVOKE UPDATE on this table for the app's runtime role (see
  // migration.sql), same pattern as audit_logs.

  promotionBatch         PromotionBatch      @relation(fields: [promotionBatchId], references: [id], onDelete: Cascade)
  studentEnrollment      StudentEnrollment   @relation(fields: [studentEnrollmentId], references: [id])
  fromSemesterEnrollment SemesterEnrollment  @relation("DecisionClosesEnrollment", fields: [fromSemesterEnrollmentId], references: [id])
  toSemesterEnrollment   SemesterEnrollment? @relation("DecisionOpensEnrollment", fields: [toSemesterEnrollmentId], references: [id])
  decidedBy              User                @relation(fields: [decidedByUserId], references: [id])
  // NOTE: does not enforce fromSemesterEnrollment/toSemesterEnrollment belong
  // to the same studentEnrollmentId as this decision — three-way agreement
  // across independent FKs, not expressible without a trigger. Enforce in
  // the promotion service before insert (see ANALYSIS.md §G).

  @@unique([promotionBatchId, studentEnrollmentId])
  @@index([studentEnrollmentId])
  @@map("promotion_decisions")
}

// DOMAIN 4 — CURRICULUM (Subjects, Components, Electives)

enum SubjectComponentType {
  THEORY
  PRACTICAL
  TUTORIAL
  PROJECT
}

model Subject {
  id                String  @id @default(uuid())
  organizationId    String
  semesterCatalogId String
  electiveGroupId   String? // null for core subjects
  code              String
  name              String
  isElective        Boolean @default(false)

  semesterCatalog    SemesterCatalog            @relation(fields: [organizationId, semesterCatalogId], references: [organizationId, id])
  electiveGroup      ElectiveGroup?             @relation(fields: [electiveGroupId], references: [id])
  components         SubjectComponent[]
  offerings          SubjectOffering[]
  electiveSelections StudentElectiveSelection[]

  organization Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([semesterCatalogId, code])
  @@unique([organizationId, id]) // composite-FK target for SubjectOffering
  @@index([organizationId])
  @@map("subjects")
}

// Groups mutually-exclusive open/departmental electives together within one
// semester catalog (e.g. "Open Elective Group 1": choose one of Python/AI/Cloud).
model ElectiveGroup {
  id                String @id @default(uuid())
  semesterCatalogId String
  name              String
  minSelect         Int    @default(1)
  maxSelect         Int    @default(1)

  semesterCatalog SemesterCatalog            @relation(fields: [semesterCatalogId], references: [id])
  subjects        Subject[]
  selections      StudentElectiveSelection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([semesterCatalogId, name])
  @@map("elective_groups")
}

// KNOWN SIMPLIFICATION (kept — see ANALYSIS.md §J): the unique constraint
// below assumes exactly one selection per group per enrollment — correct for
// the common maxSelect=1 case. If a group ever allows choosing 2+ electives,
// drop the uniqueness and cap via an app-layer count check against
// ElectiveGroup.maxSelect instead.
model StudentElectiveSelection {
  id                   String @id @default(uuid())
  semesterEnrollmentId String
  electiveGroupId      String
  subjectId            String

  semesterEnrollment SemesterEnrollment @relation(fields: [semesterEnrollmentId], references: [id], onDelete: Cascade)
  electiveGroup      ElectiveGroup      @relation(fields: [electiveGroupId], references: [id])
  subject            Subject            @relation(fields: [subjectId], references: [id])
  // Deliberately no direct relation to StudentEnrollment (unchanged).
  // Cross-curriculum guard (subject/group/enrollment must share one
  // SemesterCatalog) stays service-layer — three-way join-path check.

  createdAt DateTime @default(now())

  @@unique([semesterEnrollmentId, electiveGroupId])
  @@map("student_elective_selections")
}

model SubjectComponent {
  id           String               @id @default(uuid())
  subjectId    String
  type         SubjectComponentType
  credits      Int
  hoursPerWeek Int

  subject            Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  facultyAssignments FacultyAssignment[]
  timetableEntries   Timetable[]
  lectures           Lecture[]

  @@unique([subjectId, type])
  @@map("subject_components")
}

// The OFFERING concept — "Data Structures taught to Div A in 2025-26." One
// row per subject+division+term regardless of how many components/faculty.
model SubjectOffering {
  id             String @id @default(uuid())
  organizationId String
  subjectId      String
  divisionId     String
  academicYearId String

  subject            Subject             @relation(fields: [organizationId, subjectId], references: [organizationId, id])
  division           Division            @relation(fields: [organizationId, divisionId], references: [organizationId, id])
  academicYear       AcademicYear        @relation(fields: [organizationId, academicYearId], references: [organizationId, id])
  organization       Organization        @relation(fields: [organizationId], references: [id])
  // Composite FKs on all three: guarantees organizationId = Subject's org =
  // Division's org = AcademicYear's org, per the brief's explicit requirement.
  // NOTE: does not enforce "Subject's Program == Division's Program" — that
  // requires walking Subject -> SemesterCatalog -> CurriculumVersion ->
  // Program vs. Division -> Program, a 3-hop comparison. Service-layer check
  // at offering-creation time.
  facultyAssignments FacultyAssignment[]
  timetableEntries   Timetable[]
  lectures           Lecture[]
  assignments        Assignment[]
  studyMaterials     StudyMaterial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subjectId, divisionId, academicYearId])
  @@unique([organizationId, id]) // composite-FK target for FacultyAssignment,
  // Timetable, Lecture
  @@index([divisionId, academicYearId])
  @@map("subject_offerings")
}

// DOMAIN 5 — TEACHING (Faculty Assignment, Rooms, Timetable)

// MVP simplification: one faculty per (offering, component) — no batch
// dimension, so no reason for this to be a list.
model FacultyAssignment {
  id                 String @id @default(uuid())
  organizationId     String // NEW — denormalized from SubjectOffering.organizationId.
  // Needed so Timetable/Lecture can carry a composite FK proving the
  // faculty assignment belongs to the same org as the room/timeslot they
  // reference, without a multi-hop join inside a constraint.
  subjectOfferingId  String
  subjectComponentId String
  facultyUserId      String

  organization     Organization     @relation(fields: [organizationId], references: [id])
  subjectOffering  SubjectOffering  @relation(fields: [organizationId, subjectOfferingId], references: [organizationId, id], onDelete: Cascade)
  subjectComponent SubjectComponent @relation(fields: [subjectComponentId], references: [id])
  faculty          User             @relation(fields: [facultyUserId], references: [id])
  // NOTE: does not verify facultyUserId belongs to this organization, or
  // holds a faculty-capable role — that's an RBAC concern, not a plain FK
  // (role membership is itself a table, not a boolean flag on User).
  // Enforce via the RBAC service at assignment time (ANALYSIS.md §G).
  // NOTE: does not verify subjectComponentId belongs to subjectOffering's
  // Subject — 2-hop check (SubjectOffering -> Subject -> SubjectComponent),
  // service-layer.

  timetableEntries Timetable[]
  lectures         Lecture[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subjectOfferingId, subjectComponentId])
  @@unique([organizationId, id]) // composite-FK target for Timetable, Lecture
  @@index([facultyUserId])
  @@index([organizationId])
  @@map("faculty_assignments")
}

enum RoomType {
  LECTURE_HALL
  LABORATORY
  SEMINAR_HALL
}

model Room {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  type           RoomType
  capacity       Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timetableEntries Timetable[]
  lectures         Lecture[]

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@unique([organizationId, id]) // composite-FK target for Timetable, Lecture
  @@map("rooms")
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model TimeSlot {
  id             String    @id @default(uuid())
  organizationId String
  dayOfWeek      DayOfWeek
  startTime      DateTime  @db.Time
  endTime        DateTime  @db.Time

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timetableEntries Timetable[]

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, id]) // composite-FK target for Timetable
  @@index([organizationId, dayOfWeek])
  @@map("time_slots")
}

// The RECURRING pattern — "this slot happens every Tuesday 10-11am in Room
// 204, for as long as effectiveTo is null."
model Timetable {
  id             String    @id @default(uuid())
  organizationId String // NEW — denormalized, ties this row to one tenant
  // directly so it can carry composite FKs to Room/TimeSlot/SubjectOffering/
  // FacultyAssignment, and so the EXCLUDE conflict constraints in
  // migration.sql don't need to join out to establish org scope.
  divisionId     String // NEW — denormalized from subjectOffering.divisionId.
  // Required for the "Division IT-A cannot have two simultaneous lectures"
  // EXCLUDE constraint (migration.sql) — an exclusion constraint needs the
  // conflicting value directly on the row, it cannot join through
  // subjectOffering at constraint-check time.
  dayOfWeek      DayOfWeek // NEW — denormalized copy of timeSlot.dayOfWeek
  startTime      DateTime  @db.Time // NEW — denormalized copy of timeSlot.startTime
  endTime        DateTime  @db.Time // NEW — denormalized copy of timeSlot.endTime
  // These three are copied from TimeSlot at write time, same reasoning as
  // divisionId: the weekly-recurring EXCLUDE constraint in migration.sql
  // needs the day/time on the Timetable row itself — it cannot join through
  // timeSlotId to evaluate a conflict. This is safe because a Timetable row
  // is closed (effectiveTo set) and a new one created on any change, never
  // edited in place — so the copy never goes stale under an existing row.

  subjectOfferingId   String
  subjectComponentId  String
  facultyAssignmentId String
  timeSlotId          String
  roomId              String
  effectiveFrom       DateTime  @default(now())
  effectiveTo         DateTime? // set when faculty/room/slot changes mid-term;
  // row is closed, never edited in place
  isCancelled         Boolean   @default(false)

  organization      Organization      @relation(fields: [organizationId], references: [id])
  subjectOffering   SubjectOffering   @relation(fields: [organizationId, subjectOfferingId], references: [organizationId, id])
  division          Division          @relation(fields: [organizationId, divisionId], references: [organizationId, id])
  subjectComponent  SubjectComponent  @relation(fields: [subjectComponentId], references: [id])
  facultyAssignment FacultyAssignment @relation(fields: [organizationId, facultyAssignmentId], references: [organizationId, id])
  timeSlot          TimeSlot          @relation(fields: [organizationId, timeSlotId], references: [organizationId, id])
  room              Room              @relation(fields: [organizationId, roomId], references: [organizationId, id])
  // Room/Faculty/Division scheduling-conflict prevention is NOT expressible
  // as a Prisma relation or @@unique — see migration.sql for the
  // btree_gist EXCLUDE constraints that do the actual conflict rejection.
  // The indexes below remain purely for query performance.

  lectures Lecture[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([timeSlotId, roomId])
  @@index([subjectOfferingId])
  @@index([organizationId])
  @@map("timetables")
}

enum LectureStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

// The ACTUAL dated occurrence — where attendance attaches. Usually generated
// from a Timetable row; timetableId is nullable so an ad-hoc extra class
// doesn't need a fake recurring pattern behind it.
model Lecture {
  id             String @id @default(uuid())
  organizationId String // NEW — see Timetable.organizationId comment; same reasoning.
  divisionId     String // NEW — see Timetable.divisionId comment; same reasoning.
  facultyUserId  String // NEW — denormalized from facultyAssignment.facultyUserId.
  // The EXCLUDE constraint for "faculty can't teach two overlapping lectures"
  // needs the actual person, not the (offering, component) assignment row —
  // the same faculty member could hold two different FacultyAssignment rows
  // (different subjects) and still double-book themselves.

  timetableId         String?
  subjectOfferingId   String
  subjectComponentId  String
  facultyAssignmentId String
  roomId              String
  scheduledDate       DateTime      @db.Date
  startTime           DateTime      @db.Time
  endTime             DateTime      @db.Time
  status              LectureStatus @default(SCHEDULED)

  organization      Organization       @relation(fields: [organizationId], references: [id])
  division          Division           @relation(fields: [organizationId, divisionId], references: [organizationId, id])
  facultyUser       User               @relation("LectureFaculty", fields: [facultyUserId], references: [id])
  timetable         Timetable?         @relation(fields: [timetableId], references: [id])
  subjectOffering   SubjectOffering    @relation(fields: [organizationId, subjectOfferingId], references: [organizationId, id])
  subjectComponent  SubjectComponent   @relation(fields: [subjectComponentId], references: [id])
  facultyAssignment FacultyAssignment  @relation(fields: [organizationId, facultyAssignmentId], references: [organizationId, id])
  room              Room               @relation(fields: [organizationId, roomId], references: [organizationId, id])
  attendanceSession AttendanceSession?
  // As with Timetable: Room/Faculty/Division double-booking prevention is a
  // Postgres EXCLUDE constraint in migration.sql, not expressible here.
  // subjectComponent belonging to subjectOffering.subject, and
  // facultyAssignment belonging to the same offering/component, remain
  // service-layer (multi-hop agreement checks) — see ANALYSIS.md §G.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subjectOfferingId, scheduledDate, startTime])
  @@index([facultyAssignmentId, scheduledDate])
  @@index([organizationId])
  @@map("lectures")
}

// DOMAIN 6 — ATTENDANCE

enum AttendanceSessionStatus {
  OPEN
  LOCKED
}

// 1:1 with Lecture, deliberately — no batch dimension. The Lecture already
// carries the division; this row just anchors AttendanceRecord rows.
model AttendanceSession {
  id            String                  @id @default(uuid())
  lectureId     String                  @unique
  takenByUserId String
  status        AttendanceSessionStatus @default(OPEN)
  lockedAt      DateTime?

  lecture Lecture            @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  takenBy User               @relation(fields: [takenByUserId], references: [id])
  records AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("attendance_sessions")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model AttendanceRecord {
  id                   String           @id @default(uuid())
  attendanceSessionId  String
  semesterEnrollmentId String // ties to the student's CURRENT term context,
  // not the bare User — consistent with the catalog/offering split elsewhere
  status               AttendanceStatus
  markedByUserId       String
  correctedAt          DateTime?
  correctionReason     String?
  correctedByUserId    String? // NEW — a correction changes an academic
  // record after the fact; who made it must be independently attributable
  // from who marked it originally (markedByUserId), for audit purposes.
  // Nullable because most records are never corrected.

  attendanceSession  AttendanceSession  @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  semesterEnrollment SemesterEnrollment @relation(fields: [semesterEnrollmentId], references: [id])
  markedBy           User               @relation(fields: [markedByUserId], references: [id])
  correctedBy        User?              @relation("AttendanceCorrectedBy", fields: [correctedByUserId], references: [id])
  // Eligibility guard (SemesterEnrollment.division/academicYear must match
  // Lecture.subjectOffering.division/academicYear) is NOT DB-expressible —
  // two independent join paths, not a shared FK. Enforced in the attendance
  // service at record-creation time (ANALYSIS.md §G/§K). A DB CHECK that
  // correctedAt and correctionReason are both set or both null is added in
  // migration.sql.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attendanceSessionId, semesterEnrollmentId])
  @@index([semesterEnrollmentId, status])
  @@map("attendance_records")
}

// DOMAIN 7 — ASSIGNMENTS & STUDY MATERIAL
// Attachments deliberately do NOT get their own tables (no
// AssignmentAttachment / StudyMaterialAttachment) — see Document below.

model Assignment {
  id                String   @id @default(uuid())
  subjectOfferingId String
  title             String
  description       String
  dueAt             DateTime
  maxMarks          Int?
  createdByUserId   String

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  subjectOffering SubjectOffering        @relation(fields: [subjectOfferingId], references: [id])
  createdBy       User                   @relation(fields: [createdByUserId], references: [id])
  submissions     AssignmentSubmission[]

  @@index([subjectOfferingId])
  @@map("assignments")
}

enum SubmissionStatus {
  SUBMITTED
  LATE
  GRADED
  RESUBMISSION_REQUESTED
}

model AssignmentSubmission {
  id                   String           @id @default(uuid())
  assignmentId         String
  semesterEnrollmentId String // same "tie to term context, not bare User"
  // convention as AttendanceRecord
  status               SubmissionStatus @default(SUBMITTED)
  submittedAt          DateTime         @default(now())
  marksAwarded         Int?
  feedback             String?
  gradedByUserId       String?
  gradedAt             DateTime?

  assignment         Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  semesterEnrollment SemesterEnrollment @relation(fields: [semesterEnrollmentId], references: [id])
  gradedBy           User?              @relation(fields: [gradedByUserId], references: [id])
  // marksAwarded <= assignment.maxMarks: a CHECK constraint cannot reference
  // another table's column in Postgres. Enforced in the grading service
  // before UPDATE (ANALYSIS.md §G). Cross-division submission guard is the
  // same class of check as AttendanceRecord's eligibility guard — service-layer.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, semesterEnrollmentId])
  @@index([semesterEnrollmentId])
  @@map("assignment_submissions")
}

model StudyMaterial {
  id                String  @id @default(uuid())
  subjectOfferingId String
  title             String
  description       String?
  uploadedByUserId  String

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  subjectOffering SubjectOffering @relation(fields: [subjectOfferingId], references: [id])
  uploadedBy      User            @relation(fields: [uploadedByUserId], references: [id])

  @@index([subjectOfferingId])
  @@map("study_materials")
}

// DOMAIN 8 — COMMUNICATION (Notice, Notification, Calendar)

model Notice {
  id              String    @id @default(uuid())
  organizationId  String
  title           String
  body            String
  publishedAt     DateTime?
  createdByUserId String

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  createdBy    User             @relation(fields: [createdByUserId], references: [id])
  audiences    NoticeAudience[]

  @@index([organizationId, publishedAt])
  @@map("notices")
}

// Separate table, not a single scope pair on Notice, because one notice may
// need to target MULTIPLE audiences at once — a single scopeType/scopeId
// pair can't express that fan-out.
model NoticeAudience {
  id       String    @id @default(uuid())
  noticeId String
  scope    ScopeType
  scopeId  String? // null when scope = ORGANIZATION — enforced via CHECK in
  // migration.sql. Polymorphic FK to Department OR Division depending on
  // `scope` remains service-layer, same reasoning as RoleAssignment.scopeId.

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@index([noticeId])
  @@index([scope, scopeId])
  @@map("notice_audiences")
}

enum NotificationType {
  NOTICE_PUBLISHED
  ASSIGNMENT_DUE
  ATTENDANCE_LOW
  GRADE_POSTED
  ROLE_GRANTED
  GENERIC
}

// Split from NotificationRecipient deliberately: a notice going to 500
// students shouldn't duplicate title/body 500 times — one Notification row,
// many per-user delivery/read-state rows.
model Notification {
  id             String           @id @default(uuid())
  organizationId String
  type           NotificationType
  title          String
  body           String
  metadata       Json? // polymorphic reference payload — e.g. { assignmentId }

  createdAt DateTime @default(now())

  organization Organization            @relation(fields: [organizationId], references: [id])
  recipients   NotificationRecipient[]
  // Notification.organizationId matching recipient.user.organizationId is a
  // tenant boundary spanning Notification -> NotificationRecipient -> User,
  // a 2-hop check. Not composite-FK-able without denormalizing organizationId
  // onto NotificationRecipient too, which would only move the same check one
  // hop rather than remove it (User.organizationId is still authoritative).
  // Enforced in the notification-fanout service when building recipient
  // rows: only ever query recipients from `WHERE user.organizationId =
  // notification.organizationId`, never accept an arbitrary userId list.

  @@index([organizationId, type])
  @@map("notifications")
}

model NotificationRecipient {
  id             String    @id @default(uuid())
  notificationId String
  userId         String
  deliveredAt    DateTime?
  readAt         DateTime?

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt])
  @@map("notification_recipients")
}

enum CalendarEventType {
  HOLIDAY
  EXAM
  WORKSHOP
  SEMINAR
  PLACEMENT
  TECH_FEST
  SPORTS
  MEETING
  OTHER
}

model CalendarEvent {
  id              String            @id @default(uuid())
  organizationId  String
  type            CalendarEventType
  title           String
  description     String?
  startAt         DateTime
  endAt           DateTime
  scopeType       ScopeType         @default(ORGANIZATION) // reuses the
  // existing RBAC/Notice scope enum rather than inventing a new one
  scopeId         String? // null when scopeType = ORGANIZATION — enforced
  // via CHECK in migration.sql, same as NoticeAudience/RoleAssignment.
  createdByUserId String

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User         @relation(fields: [createdByUserId], references: [id])

  @@index([organizationId, startAt])
  @@index([scopeType, scopeId])
  @@map("calendar_events")
}

// DOMAIN 9 — SYSTEM (Documents, Audit, Settings)

enum DocumentOwnerType {
  ASSIGNMENT
  ASSIGNMENT_SUBMISSION
  STUDY_MATERIAL
  NOTICE
}

model Document {
  id               String            @id @default(uuid())
  organizationId   String
  ownerType        DocumentOwnerType
  ownerId          String
  fileName         String
  mimeType         String
  sizeBytes        Int
  storageKey       String // path/key in Cloudflare R2 / S3 — DB stores
  // metadata only, actual bytes live in object storage
  uploadedByUserId String

  deletedAt DateTime?
  createdAt DateTime  @default(now())

  uploadedBy   User         @relation(fields: [uploadedByUserId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  // ownerId is polymorphic (points at Assignment, AssignmentSubmission,
  // StudyMaterial, or Notice depending on ownerType) — no real FK is
  // possible without a generic ownership table, which is not worth the
  // complexity for four owner types. The document service MUST verify: the
  // owner row exists, the owner belongs to this organizationId, ownerType is
  // one of the four valid values, and uploadedByUserId belongs to the same
  // organization — before persisting. MIME-type validation and file-size
  // sanity checks happen outside the DB entirely (at upload time); object
  // storage remains the sole source of file bytes.

  @@index([organizationId, ownerType, ownerId])
  @@map("documents")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ARCHIVE
  RESTORE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  LOGOUT_ALL_DEVICES
  SESSION_REVOKED
  ACCOUNT_ACTIVATED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  ROLE_GRANTED
  ROLE_REVOKED
  PERMISSION_CHANGED
  OTHER
}

model AuditLog {
  id             String      @id @default(uuid())
  organizationId String?
  actorUserId    String?
  action         AuditAction
  entityType     String

  entityId  String
  oldValue  Json?
  newValue  Json?
  requestId String? // NEW — correlates an audit row back to the exact HTTP
  // request that produced it (Phase 10). Populated automatically from the
  // AsyncLocalStorage log context by auditService.record/recordTx; callers
  // only need to pass it explicitly if recording outside a request (a job).
  ipAddress String?
  userAgent String?
  // Deliberately no updatedAt: append-only. oldValue/newValue must NEVER
  // contain passwordHash, refresh/session token values, or verification
  // token hashes — the audit-writing service is responsible for redacting
  // these fields before serializing a diff. DB-level append-only enforcement
  // (REVOKE UPDATE/DELETE for the app's runtime role) requires a separate
  // migration/runtime-role from the migration/owner role — NOT YET
  // CONFIGURED in this deployment (single dev role). See
  // docs/architecture/production-deployment.md for the required production
  // model. Until that separation exists, append-only is enforced only by
  // the application never exposing an update/delete endpoint for this table
  // — a real gap, not a solved one; do not claim otherwise.

  createdAt DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt])
  @@index([organizationId, action, createdAt])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

model OrganizationSetting {
  id             String @id @default(uuid())
  organizationId String
  key            String
  value          Json // intentionally loose — supports any setting shape
  // (string, number, boolean, nested object) without a migration per new key.
  // Recommendation (application-level, not a schema change): back this with
  // a typed settings registry/validation layer in the service — a known set
  // of `key` -> expected-shape mappings, validated on write — rather than
  // normalizing every setting into its own relational column. Core business
  // data (everything above) stays relational; this stays JSON deliberately.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("organization_settings")
}
